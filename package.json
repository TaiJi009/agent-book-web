{
  "name": "agent-book-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single",
    "preview": "vite preview",
    "content": "node scripts/extract-book.mjs && node scripts/extract-experiments.mjs && node scripts/build-search-index.mjs && node scripts/build-walkthroughs.mjs && node scripts/build-reference.mjs",
    "content:en": "node scripts/extract-book.mjs --locale=en && node scripts/extract-experiments.mjs --locale=en && node scripts/build-search-index.mjs --locale=en && node scripts/build-walkthroughs.mjs --locale=en && node scripts/build-reference.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/lora": "^5.2.5",
    "@fontsource/noto-sans-sc": "^5.2.5",
    "@fontsource/noto-serif-sc": "^5.2.5",
    "@fontsource/poppins": "^5.2.5",
    "@tailwindcss/vite": "^4.1.7",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "katex": "^0.19.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
