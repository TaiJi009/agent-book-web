span></span>\n<span class=\"line\"><span>  - provider-tests.js: 完整的提供商测试</span></span>\n<span class=\"line\"><span>- run-tests.js: 带环境校验的测试运行器</span></span>\n<span class=\"line\"><span>- utils/providers/: 提供商配置（ASR / LLM / TTS）</span></span>\n<span class=\"line\"><span>- package.json: 后端依赖和脚本</span></span></code></pre>"},{"kind":"code","lang":"text","html":"<pre class=\"shiki shiki-themes vitesse-light vitesse-dark\" style=\"--shiki-light:#393a34;--shiki-dark:#dbd7caee;--shiki-light-bg:#ffffff;--shiki-dark-bg:#121212\" tabindex=\"0\"><code><span class=\"line\"><span>/frontend</span></span>\n<span class=\"line\"><span>- pages/: Next.js 页面</span></span>\n<span class=\"line\"><span>  - index.tsx: 主应用界面</span></span>\n<span class=\"line\"><span>- components/: 可复用 UI 组件</span></span>\n<span class=\"line\"><span>- public/: 静态资源</span></span>\n<span class=\"line\"><span>  - audioWorklet.js: 音频处理与 VAD 实现</span></span>\n<span class=\"line\"><span>- next.config.js: Next.js 配置</span></span>\n<span class=\"line\"><span>- tailwind.config.js: Tailwind CSS 设置</span></span>\n<span class=\"line\"><span>- package.json: 前端依赖和脚本</span></span></code></pre>"},{"kind":"heading","depth":4,"text":"安装","id":"rh-22"},{"kind":"list","ordered":true,"items":[[{"kind":"p","c":[{"t":"text","v":"克隆仓库"}]}],[{"kind":"p","c":[{"t":"text","v":"安装后端依赖："}]},{"kind":"code","lang":"bash","value":"cd backend && npm install"}],[{"kind":"p","c":[{"t":"text","v":"安装前端依赖："}]},{"kind":"code","lang":"bash","value":"cd frontend && npm install"}],[{"kind":"p","c":[{"t":"text","v":"下载 Silero VAD 模型（本仓库已在 "},{"t":"code","v":"backend/models/silero_vad.onnx"},{"t":"text","v":" 包含该文件；仅在文件缺失时需要）："}]},{"kind":"code","lang":"bash","value":"cd backend/models\nwget https://huggingface.co/deepghs/silero-vad-onnx/resolve/main/silero_vad.onnx"}],[{"kind":"p","c":[{"t":"text","v":"配置前端的 WebSocket 端口（省略时默认为 8848）："}]},{"kind":"code","lang":"bash","value":"cd frontend && cp .env.example .env   # 将 WEBSOCKET_PORT=8848 设为与后端一致"}]]},