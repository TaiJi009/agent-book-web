r_console_messages"},{"t":"text","v":", "},{"t":"code","v":"browser_network_requests"},{"t":"text","v":", "},{"t":"code","v":"browser_take_screenshot"}]}],[{"kind":"p","c":[{"t":"strong","c":[{"t":"text","v":"管理"}]},{"t":"text","v":"："},{"t":"code","v":"browser_close"},{"t":"text","v":", "},{"t":"code","v":"browser_resize"},{"t":"text","v":", "},{"t":"code","v":"browser_tabs"},{"t":"text","v":", "},{"t":"code","v":"browser_handle_dialog"}]}],[{"kind":"p","c":[{"t":"strong","c":[{"t":"text","v":"执行"}]},{"t":"text","v":"："},{"t":"code","v":"browser_evaluate"},{"t":"text","v":", "},{"t":"code","v":"browser_press_key"},{"t":"text","v":", "},{"t":"code","v":"browser_wait_for"}]}],[{"kind":"p","c":[{"t":"strong","c":[{"t":"text","v":"快照"}]},{"t":"text","v":"："},{"t":"code","v":"browser_snapshot"},{"t":"text","v":", "},{"t":"code","v":"browser_install"}]}]]},{"kind":"p","c":[{"t":"strong","c":[{"t":"text","v":"对比"}]},{"t":"text","v":"："},{"t":"code","v":"browser-server"},{"t":"text","v":" 提供高级自动化，"},{"t":"code","v":"ms-playwright"},{"t":"text","v":" 提供细粒度控制"}]},{"kind":"hr"},{"kind":"heading","depth":4,"text":"📄 文档处理工具（5 服务器，12 工具）","id":"rh-13"},{"kind":"heading","depth":4,"text":"4. Documents CSV Server (documents-csv-server)","id":"rh-14"},{"kind":"list","ordered":false,"items":[[{"kind":"p","c":[{"t":"code","v":"extract_csv_content"},{"t":"text","v":": 提取和分析 CSV 文件内容（支持 Markdown/JSON 格式输出）"}]}],[{"kind":"p","c":[{"t":"code","v":"list_supported_formats"},{"t":"text","v":": 列出支持的 CSV 格式"}]}]]},{"kind":"heading","depth":4,"text":"5. Documents DOCX Server (documents-docx-server)","id":"rh-15"},{"kind":"list","ordered":false,"items":[[{"kind":"p","c":[{"t":"code","v":"extract_docx_content"},{"t":"text","v":": 提取 Word 文档内容（包括文本、表格、图片）"}]}],[{"kind":"p","c":[{"t":"code","v":"list_supported_formats"},{"t":"text","v":": 列出支持的 DOCX 格式"}]}]]},{"kind":"heading","depth":4,"text":"6. Documents PPTX Server (documents-pptx-server)","id":"rh-16"},{"kind":"list","ordered":false,"items":