"t":"text","v":"社区与支持"}]}]}]]},{"kind":"hr"},{"kind":"heading","depth":4,"text":"简介","id":"rh-5"},{"kind":"p","c":[{"t":"text","v":"AWorld Train 是实现 "},{"t":"strong","c":[{"t":"text","v":"\"从实践中学习\"（Learning from Practice）"}]},{"t":"text","v":" 范式的开源训练框架，专门为 Agentic AI 设计。根据 "},{"t":"a","href":"https://arxiv.org/abs/2508.20404","ext":true,"c":[{"t":"text","v":"AWorld 论文"}]},{"t":"text","v":"，构建高性能 Agent 系统需要三个核心要素："}]},{"kind":"list","ordered":true,"items":[[{"kind":"p","c":[{"t":"strong","c":[{"t":"text","v":"算法（Algorithm）"}]},{"t":"text","v":"：使 Agent 能够从环境交互中适应和改进的学习机制"}]}],[{"kind":"p","c":[{"t":"strong","c":[{"t":"text","v":"环境（Environment）"}]},{"t":"text","v":"：提供丰富反馈和多样化挑战的复杂交互场景"}]}],[{"kind":"p","c":[{"t":"strong","c":[{"t":"text","v":"先验（Priors）"}]},{"t":"text","v":"：当前大模型在推理、数学、视觉等领域的基础能力"}]}]]},{"kind":"p","c":[{"t":"text","v":"AWorld Train 通过分布式架构解决了传统方法的核心瓶颈——"},{"t":"strong","c":[{"t":"text","v":"经验生成效率低下"}]},{"t":"text","v":"。在 GAIA 基准测试中，我们将数据收集速度提升了 "},{"t":"strong","c":[{"t":"text","v":"14.6 倍"}]},{"t":"text","v":"，使得大规模强化学习训练变得可行。"}]},{"kind":"heading","depth":4,"text":"⚠️ 关于本教育性实验的重要说明","id":"rh-6"},{"kind":"p","c":[{"t":"strong","c":[{"t":"text","v":"GAIA（General AI Assistants Benchmark）"}]},{"t":"text","v":" 是目前最具挑战性的 Agent 能力评测基准之一，也是 SOTA（State-of-the-Art）Agent 系统的竞技场。根据"},{"t":"a","href":"https://arxiv.org/abs/2508.20404","ext":true,"c":[{"t":"text","v":"论文"}]},{"t":"text","v":"所示："}]},{"kind":"list","ordered":false,"items":[[{"kind":"p","c":[{"t":"strong","c":[{"t":"text","v":"数据稀缺性"}]},{"t":"text","v":"：GAIA validation set 仅包含 "},{"t":"strong","c":[{"t":"text","v":"165 个问题"}]},{"t":"text","v":"，test set 约 "},{"t":"strong","c":[{"t":"text","v":"300 个问题"}]},{"t":"text","v":"，远少于传统 RL 训练所需的数据量"}]}],[{"kind":"p","c":[{"t":"strong","c":[{"t":"text","v":"计算资源需求"}]},{"t":"text","v":"：论文中的 Qwen3-32B-AWorld 模型需要在 2 台 "},{"t":"strong","c":[{"t":"text","v":"8x A100 GPU 集群"}]},{"t":"text","v":"上训练多天才能达到 32.23% 的性能，而这距离 SOTA 性能（80% 以上）还非常远"}]}],[{"kind":"p","c":[{"t":"strong","c":[{"t":"text","v":"任务复杂度"}]},{"t":"text","v":"：GAIA 问题涉及多模态理解、多步推理、工具链调用等，平均需要 10-20 轮交互才能完成"}]}]]},{"kind":"p","c":[{"t":"text","v":"因此，本项目采用了教育友好的配置，使用 Qwen3-4B-Thinking-2507 作为基座模型，训练速度较快。"}]},{"kind":"list","ordered":false,"items":[[{"kind":"p","c":[{"t":"text","v":"✅ 演示完整的 \"从实践中学习\" 训练流程"}]}],[{"kind":"p","c":[{"t":"text","v":"✅ 理解 Agent-Environment 交互机制"}]}],[{"kind":"p","c":[{"t":"text","v":"✅ 实践 RL 算法（PPO/GRPO）在 Agent 训练中的应用"}]}]]},{"kind":"heading","depth":4,"text":"核心特性","id":"rh-7"},{"kind":"list","ordered":false,"items":[[{"kind":"p","c":[{"t":"text","v":"⚡ "},{"t":"strong","c":[{"t":"text","v":"高效并发"}]},{"t":"text","v":"：分布式任务执行，14.6x 数据收集加速"}]}],[{"kind":"p","c":[{"t":"text","v":"🔌 "},{"t":"strong","c":[{"t":"text","v":"框架无关"}]},{"t":"text","v":"：支持 VeRL、OpenRLHF、AReaL、SWIFT 等主流 RL 框架"}]}],[{"kind":"p","c":[{"t":"text","v":"🛠️ "},{"t":"strong","c":[{"t":"text","v":"工具生态"}]},{"t":"text","v":"：内置 26 个 MCP 服务器，提供 "},{"t":"strong","c":[{"t":"text","v":"126 个工具函数"}]},{"t":"text","v":"，涵盖搜索、浏览器、代码执行、多模态处理等"}]}],[{"kind":"p","c":[{"t":"text","v":"📊 "},{"t":"strong","c":[{"t":"text","v":"长上下文"}]},{"t":"text","v":"：支持 131K tokens 上下文，处理复杂多轮交互"}]}],[{"kind":"p","c":[{"t":"text","v":"🎯 "},{"t":"strong","c":[{"t":"text","v":"SOTA 性能"}]},{"t":"text","v":"：Qwen3-32B-AWorld 在 GAIA 测试集达到 32.23% pass@1"}]}]]},{"kind":"hr"},{"kind":"heading","depth":4,"text":"GAIA 环境工具生态","id":"rh-8"},{"kind":"p","c":[{"t":"text","v":"根据"},{"t":"a","href":"https://arxiv.org/abs/2508.20404","ext":true,"c":[{"t":"text","v":"论文"}]},{"t":"text","v":"和 MCP Server 实现，AWorld 为 GAIA 任务提供了全面的工具支持，共计 "},{"t":"strong","c":[{"t":"text","v":"26 个 MCP 服务器"}]},{"t":"text","v":"，"},{"t":"strong","c":[{"t":"text","v":"126 个工具函数"}]},{"t":"text","v":"。以下是按类别的完整工具列表："}]},{"kind":"heading","depth":4,"text":"🌐 Web 交互工具（3 服务器，9 工具）","id":"rh-9"},{"kind":"heading","depth":4,"text":"1. Google Search Server (googlesearch-server)","id":"rh-10"},{"kind":"list","ordered":false,"items":